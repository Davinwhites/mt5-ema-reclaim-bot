# ============================================================
# MT5 CONNECTION (required)
# ============================================================
# Path to terminal64.exe (Windows). Leave empty to use default install.
MT5_PATH=

# Account credentials — use a DEMO account first
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# ============================================================
# TRADING SETTINGS
# ============================================================
# Symbol to trade (must exist in Market Watch)
SYMBOL=EURUSD

# Timeframe: M1, M5, M15, M30, H1, H4, D1
TIMEFRAME=M15

# Risk per trade as fraction of equity (0.0025 = 0.25%)
RISK_FRACTION=0.0025

# Daily loss limit as fraction of day-start equity (0.01 = 1%)
DAILY_LOSS_FRACTION=0.01

# Max drawdown from peak equity (0.03 = 3%)
MAX_DRAWDOWN_FRACTION=0.03

# Maximum open positions at once
MAX_POSITIONS=1

# Maximum allowed spread in pips
MAX_SPREAD_PIPS=2.0

# Stop and take multiples of ATR
STOP_MULTIPLE=1.5
TAKE_MULTIPLE=2.2

# Magic number so the bot only manages its own trades
MAGIC=20251020

# ============================================================
# SAFETY
# ============================================================
# Set to "true" only after thorough demo testing
LIVE_TRADING=false

# How often the main loop checks for new bars (seconds)
POLL_SECONDS=5

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
